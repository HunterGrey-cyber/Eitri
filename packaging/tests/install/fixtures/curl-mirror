#!/bin/sh
# Test double for curl against a non-loopback --base-url (https://mirror.example): records its argv
# in <scratch>/logs/curl.log, then serves the URL's path from <scratch>/srv, failing like `curl -f`
# (exit 22) when there is no such file.
S=$(cd "$(dirname "$0")/.." && pwd)
{
	printf 'curl'
	printf ' %s' "$@"
	printf '\n'
} >>"$S/logs/curl.log"
out=-
url=
while [ $# -gt 0 ]; do
	case $1 in
	-o) out=$2; shift ;;
	--) url=$2; shift ;;
	-*) ;;
	*) url=$1 ;;
	esac
	shift
done
p=${url#*://}
p=/${p#*/}
[ -f "$S/srv$p" ] || exit 22
if [ "$out" = - ]; then cat "$S/srv$p"; else cat "$S/srv$p" >"$out"; fi
