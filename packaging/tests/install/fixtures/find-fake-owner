#!/bin/sh
# Test double for `find`: reports a directory as owned by another user for ownership checks.
# The sandbox cannot chown to another uid without root, which an installer test must never use.
# For `find PATH ...-uid...` or `find -H PATH ...`, a path named in
# <scratch>/logs/fake-owner-path is reported as a hit, as real find would for `! -uid OUR_ID`.
# Every other invocation, including other predicates on the same path, runs the real find.
S=$(cd "$(dirname "$0")/.." && pwd)
real=
for m in /usr/bin/find /bin/find; do
	if [ -x "$m" ]; then real=$m; break; fi
done
[ -n "$real" ] || exit 127
_marker=$S/logs/fake-owner-path
_path=$1
if [ "$1" = -H ]; then _path=$2; fi
if [ -f "$_marker" ] && [ "$_path" = "$(cat "$_marker")" ]; then
	case " $* " in
	*' -uid '*)
		printf '%s\n' "$_path"
		exit 0
		;;
	esac
fi
exec "$real" "$@"
