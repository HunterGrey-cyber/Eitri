#!/bin/sh
# Test double for the claude CLI: the host's real claude must never run from an installer test.
# Records argv in <scratch>/logs/claude.log and prints a version for the installer's check.
S=$(cd "$(dirname "$0")/.." && pwd)
{
	printf 'claude-stub'
	printf ' %s' "$@"
	printf '\n'
} >>"$S/logs/claude.log"
printf '%s\n' '2.1.283 (Claude Code)'
