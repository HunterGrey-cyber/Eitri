#!/bin/sh
# Test double for `uname`: reports aarch64 for `-m`, passing other calls to the real utility.
# Neither check_platform (which refuses prebuilt installs off x86_64) nor check_glibc calls uname.
case "$*" in
-m) printf 'aarch64\n' ;;
*)
	for u in /usr/bin/uname /bin/uname; do
		if [ -x "$u" ]; then exec "$u" "$@"; fi
	done
	exit 127
	;;
esac
