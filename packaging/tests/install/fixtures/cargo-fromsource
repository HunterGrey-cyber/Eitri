#!/bin/sh
# Test double for the cargo build --release --locked command used by --from-source.
# Log arguments to <scratch>/logs/cargo.log and write the four NV_BINARIES outputs
# to <target-dir>/release/ without compiling. The test mode defaults to "ok".
# "fail" exits 1 on build, stopping do_from_source. "skip" exits 0 without outputs,
# simulating a redirected or skipped build. This checks that do_from_source removes
# old shipped binaries before building, so staging fails instead of reusing stale files.
# Honor --target-dir before CARGO_TARGET_DIR, then default to the workspace's target/.
# This lets tests check that do_from_source's explicit flag overrides the environment.
S=$(cd "$(dirname "$0")/.." && pwd)
{
	printf 'cargo'
	printf ' %s' "$@"
	printf '\n'
	# The URL is also recorded, so a test can assert the pinned, checksummed Skia archive
	# (never skia-bindings' own unauthenticated download) is what the build actually saw.
	printf 'SKIA_BINARIES_URL=%s\n' "${SKIA_BINARIES_URL:-<unset>}"
} >>"$S/logs/cargo.log"
case $1 in
build)
	case ${NEOVIBE_INSTALL_TEST_CARGO_MODE:-ok} in
	fail)
		echo "cargo-fromsource-stub: simulated build failure" >&2
		exit 1
		;;
	skip)
		exit 0
		;;
	esac
	_cfs_target_dir=
	_cfs_prev=
	for _cfs_a in "$@"; do
		if [ "$_cfs_prev" = --target-dir ]; then _cfs_target_dir=$_cfs_a; fi
		_cfs_prev=$_cfs_a
	done
	if [ -z "$_cfs_target_dir" ]; then _cfs_target_dir=${CARGO_TARGET_DIR:-target}; fi
	mkdir -p "$_cfs_target_dir/release" || exit 1
	for b in shell neovibe-supervisor neovibe-tmux-shim neovibe-claude-handoff agent-hook; do
		printf '#!/bin/sh\necho "stub %s (from-source test build)"\n' "$b" >"$_cfs_target_dir/release/$b" || exit 1
		chmod 0755 "$_cfs_target_dir/release/$b" || exit 1
	done
	exit 0
	;;
--version)
	printf 'cargo 1.96.0-fromsource-stub\n'
	exit 0
	;;
*)
	echo "cargo-fromsource-stub: unexpected argv: $*" >&2
	exit 1
	;;
esac
