#!/bin/sh
# Test double for update-desktop-database: the host's real one must not run from an installer test (it
# writes mimeinfo.cache, which would make the expected tree depend on whether the tool is installed).
# Records its argv in <scratch>/logs/desktop-db.log and writes nothing.
S=$(cd "$(dirname "$0")/.." && pwd)
{
	printf 'update-desktop-database'
	printf ' %s' "$@"
	printf '\n'
} >>"$S/logs/desktop-db.log"
exit 0
