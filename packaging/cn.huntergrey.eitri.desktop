[Desktop Entry]
Type=Application
Name=Eitri
Comment=A workspace for your own Neovim: coding agents, rendered Markdown and terminals, tiled in one window
Comment[zh_CN]=给你自己的 Neovim 一个工作环境：编程 agent、渲染好的 Markdown 和终端，平铺在一个窗口里
Exec=/usr/bin/eitri --quiet --from-desktop %F
Icon=cn.huntergrey.eitri
StartupWMClass=cn.huntergrey.eitri
Terminal=false
Categories=Development;TextEditor;
MimeType=inode/directory;text/plain;text/markdown;text/x-csrc;text/x-c++src;text/x-python;text/rust;application/json;application/toml;application/x-shellscript;
StartupNotify=true
