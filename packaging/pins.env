# Pinned downloads for building Eitri. `KEY=value`, one per line, parsed by packaging/install.sh's own `case` loop (kv_get/
# kv_value -- the same reader RELEASE uses), never sourced or eval'd. `release.sh`
# copies these into RELEASE; `--from-source` reads this file itself out of the
# cloned tree; `eitri-bin`'s PKGBUILD reads the Node pair to fill its own
# `source=`/`sha256sums`.
#
# NODE_VERSION / NODE_SHA256_linux_x64 / NODE_SHA256_linux_arm64: the Node the sidecar's Node SEA
# build injects itself into (the blob must come from the exact same Node
# version as the base binary, and a distro Node segfaults when used this way, measured by Verdandi
# 2026-09-18). Read off the public Verdandi's own pin, `apps/claude-sidecar/scripts/buildBinary.mjs`
# (`NODE_VERSION`, `NODE_TARBALL_SHA256`), at the public Verdandi commit b0f043f.
# Bumping this is a deliberate act with a consequence (that file's own comment): the shipped
# sidecar's runtime changes. Update both this file and the public Verdandi pin together, and
# re-verify with one real run.
NODE_VERSION=v22.23.2
NODE_SHA256_linux_x64=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307
NODE_SHA256_linux_arm64=fff4078c5def658577f92c88db7db3bc0072924bfb93fe52c1e744a54e94abb8

# GRPC_TOOLS_VERSION: packages["node_modules/grpc-tools"].version in package-lock.json
# at Verdandi a6279931ef65b14a47834f8bbc570864ef5b932d, pinned by agent/Cargo.toml.
# GRPC_TOOLS_SHA256_linux_x64 / GRPC_TOOLS_SHA256_linux_arm64: SHA-256 of the corresponding
# linux-x64.tar.gz / linux-arm64.tar.gz archives fetched from release.sh's upstream URL:
# https://node-precompiled-binaries.grpc.io/grpc-tools/v1.13.1/linux-<arch>.tar.gz
# Each archive lists exactly bin/, bin/grpc_node_plugin and bin/protoc.
GRPC_TOOLS_VERSION=1.13.1
GRPC_TOOLS_SHA256_linux_x64=179eb5ff3b18827b06ae015433932c75b1c18b023847b414d31dbb92ea5677a3
GRPC_TOOLS_SHA256_linux_arm64=3491d4001cb8b07109ed94da5d05d032ece21d3229ac46191027ccfd1dfc9b56

# Every pinned download lives in this one file: the sidecar's Node pair above, the
# compiler pins, the nvim pair, and the Skia, nfpm and rustup pairs below.

# NVIM_VERSION / NVIM_SHA256_linux_x86_64: the nvim release offered by the installer when
# none on PATH is new enough: 0.12.6, the newest stable release. 0.11.2 was pinned before because
# neovim's releases stopped publishing a checksum file after it (v0.11.3 through v0.12.6 carry no
# shasum.txt / *.sha256sum asset, only the tarball, the AppImage and their .zsync files), and one
# unverified download is not enough to pin. The 0.12.6 hash was cross-checked against a second
# source instead (2026-11-02): the `digest` GitHub's release API reports for the asset
# (https://api.github.com/repos/neovim/neovim/releases, `sha256:474430d5...`), the sha256 of the
# tarball downloaded by hand on one machine, and the sha256 of the same tarball downloaded again on
# a second machine that reaches GitHub by another route. All three agree. Bumping this again means
# the same checks; if the API reports no digest or any of them disagrees, do not pin. The tarball's
# top-level directory is `nvim-linux-x86_64/` (what --strip-components=1 assumes), checked
# on the 0.12.6 tarball. The kickstart and LazyVim faults tools/measure/distro_pass.py found on
# 0.11.2 are gone on 0.12.6; AstroNvim's intermittent Ctrl+j is not tied to the version.
NVIM_VERSION=0.12.6
NVIM_SHA256_linux_x86_64=474430d53e6264f6d6dd18db42d6dc9df3a1b56ca9e88a325bbf860e1a811d87

# SKIA_BINARIES_KEY / SKIA_BINARIES_URL_UPSTREAM / SKIA_BINARIES_SHA256: the prebuilt Skia archive
# skia-bindings 0.156.0 downloads and links into the shipped `shell` (see
# packaging/container/build.Dockerfile). The key is
# build_support::binary_cache::binaries::key's output -- the skia-bindings source repository hash,
# target and enabled Cargo features -- read off skia-bindings-0.156.0's own "TRYING TO DOWNLOAD"
# build log line; it has no relation to skia-bindings' own crate version (the URL's `{tag}`, which
# happens to equal that crate version too). The archive is fed to skia-bindings as
# SKIA_BINARIES_URL=file:///build/skia/<basename of the URL below>, skia-bindings' documented
# escape hatch for a pinned local copy (build_support::binary_cache::env::skia_binaries_url).
# Checked 2026-11-04 against three sources that agree: the `digest` GitHub's release API reports for
# the asset (https://api.github.com/repos/rust-skia/skia-binaries/releases/tags/0.156.0,
# `sha256:444321da...`), two downloads on one machine and one on a second machine that reaches GitHub
# by another route; 21049981 bytes. (0.153.3's archive, pinned before, was trust on first use.)
SKIA_BINARIES_KEY=ce6727ef251518df37bc-x86_64-unknown-linux-gnu-ftembed-ganesh-gl-jpegd-jpege-pdf-textlayout
SKIA_BINARIES_URL_UPSTREAM=https://github.com/rust-skia/skia-binaries/releases/download/0.156.0/skia-binaries-ce6727ef251518df37bc-x86_64-unknown-linux-gnu-ftembed-ganesh-gl-jpegd-jpege-pdf-textlayout.tar.gz
SKIA_BINARIES_SHA256=444321da446d822dc346a2b8d3f80f680ba95b1b4a34fdc98071569660b1ebf1

# NFPM_VERSION / NFPM_SHA256_linux_x86_64: the nfpm release build.Dockerfile downloads and checks by
# sha256 before installing it -- a static Go binary that writes `.deb`/
# `.rpm` without `dpkg-deb`/`rpmbuild`. 2.47.0 is the version already verified for
# packaging/nfpm.yaml/nfpm-public.yaml. The sha256 is nfpm's own published
# `checksums.txt` entry for `nfpm_2.47.0_Linux_x86_64.tar.gz`, confirmed 2026-09-27 by a fresh
# download of the tarball itself (not just the checksums file).
NFPM_VERSION=2.47.0
NFPM_SHA256_linux_x86_64=0660ca602b2d2d2ae4781a06c692b3eeb9d437ffea05b831d76e41f4a3188783

# RUSTUP_INIT_VERSION / RUSTUP_INIT_SHA256_linux_x86_64: the rustup-init build.Dockerfile downloads
# and checks by sha256 before installing Rust 1.96.0 with `--profile
# minimal` under CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup (the pitfall: only after that install
# does the Dockerfile set ENV CARGO_HOME=/build/cargo, so /opt/cargo/bin/cargo/rustup stay on PATH
# and are never hidden by the /build/cargo bind mount or the proof run's empty CARGO_HOME). 1.29.1
# was rustup's current stable release (static.rust-lang.org/rustup/release-stable.toml) on
# 2026-09-27; its sha256 is rustup's own published
# archive/1.29.1/x86_64-unknown-linux-gnu/rustup-init.sha256, confirmed the same day by a fresh
# download of rustup-init itself.
RUSTUP_INIT_VERSION=1.29.1
RUSTUP_INIT_SHA256_linux_x86_64=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
