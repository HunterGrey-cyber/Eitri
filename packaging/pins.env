# Pinned downloads for building neovibe (spec docs/superpowers/specs/2026-09-27-v1-dist-design.md
# §4.1). `KEY=value`, one per line, parsed by packaging/install.sh's own `case` loop (kv_get/
# kv_value -- the same reader RELEASE uses), never sourced or eval'd. `release.sh` (plan Task 12)
# copies these into RELEASE; `--from-source` (plan Task 11) reads this file itself out of the
# cloned tree; `neovibe-bin`'s PKGBUILD (plan Task 14) reads the Node pair to fill its own
# `source=`/`sha256sums`.
#
# NODE_VERSION / NODE_SHA256_linux_x64 / NODE_SHA256_linux_arm64: the Node the sidecar's Node SEA
# build injects itself into (spec §5.3 step 2 -- the blob must come from the exact same Node
# version as the base binary, and a distro Node segfaults when used this way, measured by Verdandi
# 2026-09-18). Read off the public Verdandi's own pin, `apps/claude-sidecar/scripts/buildBinary.mjs`
# (`NODE_VERSION`, `NODE_TARBALL_SHA256`), at the public commit b0f043f (== private c0b309e, the
# revision `agent::EXPECTED_VERDANDI_REVISION` names today) in `~/.cache/verdandi-public/repo`.
# Bumping this is a deliberate act with a consequence (that file's own comment): the shipped
# sidecar's runtime changes. Update both this file and the public Verdandi pin together, and
# re-verify (plan Task 10's "one real run").
NODE_VERSION=v22.23.2
NODE_SHA256_linux_x64=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307
NODE_SHA256_linux_arm64=fff4078c5def658577f92c88db7db3bc0072924bfb93fe52c1e744a54e94abb8

# Every pinned download lives in this one file (spec §4.1): the sidecar's Node pair above, Task 11's
# nvim pair and Task 12's Skia, nfpm and rustup pairs below.

# NVIM_VERSION / NVIM_SHA256_linux_x86_64: the nvim release offered by the installer (spec §7) when
# none on PATH is new enough. "The current stable, >= 0.11.2 for LazyVim" is 0.12.5 as of
# 2026-09-27, but neovim's own releases stopped publishing a checksum file after 0.11.2 (checked:
# v0.11.3 through v0.12.5 carry no shasum.txt / *.sha256sum asset at all, only the tarball, the
# AppImage and their .zsync files). Task 11's own instruction is to cross-check the pinned hash
# against the checksum file the release publishes, so 0.11.2 -- exactly LazyVim's own floor, and the
# newest nvim release that still ships one -- is pinned instead of the newer, unverifiable build.
# Bumping this past 0.11.2 means either trusting an unpublished checksum (downloaded and hashed by
# hand, cross-checked no other way) or waiting for neovim to publish one again; say which when it
# happens. Verified by hand: `nvim-linux-x86_64.tar.gz`'s own sha256 equals the line for it in
# https://github.com/neovim/neovim/releases/download/v0.11.2/shasum.txt, and its top-level directory
# is `nvim-linux-x86_64/` (what --strip-components=1, spec §7, assumes).
NVIM_VERSION=0.11.2
NVIM_SHA256_linux_x86_64=a9b24157672eb218ff3e33ef3f8c08db26f8931c5c04bdb0e471371dd1dfe63e

# SKIA_BINARIES_KEY / SKIA_BINARIES_URL_UPSTREAM / SKIA_BINARIES_SHA256: the prebuilt Skia archive
# skia-bindings 0.153.3 downloads and links into the shipped `shell` (spec §4.1, §4.2 step 2;
# packaging/container/build.Dockerfile, Task 12 pre-think M18). The key is
# build_support::binary_cache::binaries::key's output -- the skia-bindings source repository hash,
# target and enabled Cargo features -- read off skia-bindings-0.153.3's own "TRYING TO DOWNLOAD"
# build log line; it has no relation to skia-bindings' own crate version (the URL's `{tag}`, which
# happens to equal that crate version too). The archive is fed to skia-bindings as
# SKIA_BINARIES_URL=file:///build/skia/<basename of the URL below>, skia-bindings' documented
# escape hatch for a pinned local copy (build_support::binary_cache::env::skia_binaries_url).
# Trust on first use: first seen 2026-09-12 (14 independent container downloads since, under the
# local build cache's own skia-bindings out/.cache/, all agree), re-confirmed with a fresh `curl` +
# `sha256sum` on 2026-09-27 while writing build.Dockerfile -- same sha256, same 20375052 bytes.
SKIA_BINARIES_KEY=b7f043e0b1e2a850e702-x86_64-unknown-linux-gnu-ftembed-ganesh-gl-jpegd-jpege-pdf-textlayout
SKIA_BINARIES_URL_UPSTREAM=https://github.com/rust-skia/skia-binaries/releases/download/0.153.3/skia-binaries-b7f043e0b1e2a850e702-x86_64-unknown-linux-gnu-ftembed-ganesh-gl-jpegd-jpege-pdf-textlayout.tar.gz
SKIA_BINARIES_SHA256=ef41a8ff85bebeb06238df88e144eb04778a368fc1672a63155155d97f0caf10

# NFPM_VERSION / NFPM_SHA256_linux_x86_64: the nfpm release build.Dockerfile downloads and checks by
# sha256 before installing it (Task 12 pre-think M13) -- a static Go binary that writes `.deb`/
# `.rpm` without `dpkg-deb`/`rpmbuild` (spec §4.1). 2.47.0 is the version already verified on this
# host (Task 8, packaging/nfpm.yaml/nfpm-public.yaml). The sha256 is nfpm's own published
# `checksums.txt` entry for `nfpm_2.47.0_Linux_x86_64.tar.gz`, confirmed 2026-09-27 by a fresh
# download of the tarball itself (not just the checksums file).
NFPM_VERSION=2.47.0
NFPM_SHA256_linux_x86_64=0660ca602b2d2d2ae4781a06c692b3eeb9d437ffea05b831d76e41f4a3188783

# RUSTUP_INIT_VERSION / RUSTUP_INIT_SHA256_linux_x86_64: the rustup-init build.Dockerfile downloads
# and checks by sha256 (Task 12 pre-think M13) before installing Rust 1.96.0 with `--profile
# minimal` under CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup (the pitfall: only after that install
# does the Dockerfile set ENV CARGO_HOME=/build/cargo, so /opt/cargo/bin/cargo/rustup stay on PATH
# and are never hidden by the /build/cargo bind mount or the proof run's empty CARGO_HOME). 1.29.1
# was rustup's current stable release (static.rust-lang.org/rustup/release-stable.toml) on
# 2026-09-27; its sha256 is rustup's own published
# archive/1.29.1/x86_64-unknown-linux-gnu/rustup-init.sha256, confirmed the same day by a fresh
# download of rustup-init itself.
RUSTUP_INIT_VERSION=1.29.1
RUSTUP_INIT_SHA256_linux_x86_64=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
