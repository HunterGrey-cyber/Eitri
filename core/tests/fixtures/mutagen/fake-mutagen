#!/usr/bin/env python3
"""Replay Mutagen commands without a daemon, network, or global environment changes."""
import json
import os
from pathlib import Path
import sys
import time

argv = sys.argv[1:]
env_keys = (
    "MUTAGEN_DATA_DIRECTORY", "MUTAGEN_DISABLE_AUTOSTART", "MUTAGEN_SSH_PATH",
    "EITRI_MUTAGEN_TRANSPORT_EXE",
    "PATH", "SSH_ASKPASS", "SSH_ASKPASS_REQUIRE", "DISPLAY", "WAYLAND_DISPLAY",
)
if os.environ.get("FAKE_MUTAGEN_LOG"):
    with open(os.environ["FAKE_MUTAGEN_LOG"], "a", encoding="utf-8") as log:
        log.write(json.dumps({"argv": argv, "env": {key: os.environ.get(key) for key in env_keys}, "pid": os.getpid(), "cwd": os.getcwd()}) + "\n")
with open(os.environ["FAKE_MUTAGEN_SCRIPT"], encoding="utf-8") as script:
    replies = json.load(script)
for reply in replies:
    prefix = reply["match"]
    if argv[:len(prefix)] != prefix:
        continue
    if reply.get("once"):
        marker = Path(os.environ["FAKE_MUTAGEN_SCRIPT"]).with_name("once-" + str(replies.index(reply)))
        try:
            marker.touch(exist_ok=False)
        except FileExistsError:
            continue
    if reply.get("wait_file"):
        while not Path(reply["wait_file"]).exists():
            time.sleep(0.005)
    if reply.get("grandchild"):
        import subprocess
        subprocess.Popen([sys.executable, "-c",
            "import pathlib, sys, time; p = pathlib.Path(sys.argv[1]); "
            "exec('while not p.exists(): time.sleep(0.005)'); "
            "p.with_name(p.name + '.done').touch()", reply["grandchild"]])
    time.sleep(reply.get("sleep", 0))
    if "stdout_file" in reply:
        sys.stdout.write((Path(__file__).resolve().parent / reply["stdout_file"]).read_text(encoding="utf-8"))
    else:
        sys.stdout.write(reply.get("stdout", ""))
    sys.stderr.write(reply.get("stderr", ""))
    sys.exit(reply.get("exit", 0))
if argv[:2] in (["sync", "list"], ["sync", "monitor"]):
    if "--label-selector" in argv:
        print("[]")
        sys.exit(0)
    prefix = "list failed: " if argv[1] == "monitor" else ""
    sys.stderr.write(prefix + 'unable to locate requested sessions: specification "' + argv[-1] + '" did not match any sessions\n')
    sys.exit(1)
if argv == ["daemon"]:
    print("Usage: mutagen daemon [start|stop]")
    sys.exit(0)
sys.stderr.write("unexpected fake Mutagen arguments: " + repr(argv) + "\n")
sys.exit(2)
